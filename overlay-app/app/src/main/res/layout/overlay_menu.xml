<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mod_menu_title"
            android:textColor="@color/primary_yellow"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMinimize"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/minimize"
            android:src="@drawable/ic_minimize"
            app:tint="@color/primary_yellow" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabSystem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_selector"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tab_system"
            android:textColor="@color/tab_active"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_selector"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tab_message"
            android:textColor="@color/tab_inactive"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabTelegram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_selector"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/tab_telegram"
            android:textColor="@color/tab_inactive"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/divider" />

    <!-- SYSTEM tab -->
    <LinearLayout
        android:id="@+id/panelSystem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/system_sim_config"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSim1Mock"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/enable_sim1_mock"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSim2Mock"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/enable_sim2_mock"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mock_country_iso"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etCountryIso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:hint="in"
            android:inputType="text"
            android:maxLength="2"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/root_hide_section"
            android:textColor="@color/primary_yellow"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRootType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHideMagisk"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hide_magisk"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHideKernelSu"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_kernelsu"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHideApatch"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_apatch"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHideSukisu"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_sukisu"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHideAllRootApps"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_all_root_apps"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNotDeveloper"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/i_am_not_developer"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNotRoot"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/i_am_not_root"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/phone_spoof_section"
            android:textColor="@color/primary_yellow"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPhoneSpoof"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/enable_phone_spoof"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mock_phone_sim1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etPhoneSim1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:hint="+919876543210"
            android:inputType="phone"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mock_phone_sim2"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etPhoneSim2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:hint="+919876543211"
            android:inputType="phone"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <TextView
            android:id="@+id/tvLastOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_otp_yet"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_gradient"
            android:text="@string/save_sim_settings"
            android:textColor="@color/text_primary"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- MESSAGE tab -->
    <LinearLayout
        android:id="@+id/panelMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHookIncoming"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hook_incoming_sms"
            android:textColor="@color/text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHookOutgoing"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hook_outgoing_sms"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sender_id"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etSenderId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:hint="AD-TEST-S"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/message_body"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etMessageBody"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/input_background"
            android:gravity="top"
            android:hint="@string/message_body_hint"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInjectSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_gradient"
            android:text="@string/inject_local_sms"
            android:textColor="@color/text_primary"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- TELEGRAM tab -->
    <LinearLayout
        android:id="@+id/panelTelegram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAutoForward"
            style="@style/HivirtusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_forward_token"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/telegram_bot_token"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etBotToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:hint="123456:ABC-DEF..."
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/telegram_chat_id"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:hint="-1001234567890"
            android:inputType="numberSigned"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestTelegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_gradient"
            android:text="@string/test_telegram"
            android:textColor="@color/text_primary"
            app:backgroundTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTelegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_gradient"
            android:text="@string/save_telegram_config"
            android:textColor="@color/text_primary"
            app:backgroundTint="@null" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/footer_text"
        android:textColor="@color/text_hint"
        android:textSize="10sp" />

</LinearLayout>
