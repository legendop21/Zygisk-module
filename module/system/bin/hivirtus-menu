#!/system/bin/sh
# Hivirtus local menu — APK ke bina, sirf module
MODDIR="/data/adb/modules/hivirtus_zygisk_mode"
CFG="$MODDIR/config.json"
RUNTIME="/data/local/tmp/hivirtus_zygisk_mode_config.json"

usage() {
  echo "Virtus Zygisk — local commands (no APK)"
  echo "  hivirtus-menu status     — module + config check"
  echo "  hivirtus-menu open       — bubble hint (auto in SystemUI)"
  echo "  hivirtus-menu toggle KEY — bool flip in config.json"
  echo "  hivirtus-menu set KEY VAL — string set"
  echo "Keys: intercept_fake_success hook_incoming_sms inject_sender_id telegram_bot_token"
}

status() {
  echo "Module: $MODDIR"
  [ -f "$MODDIR/zygisk/arm64-v8a.so" ] && echo "Native: OK" || echo "Native: MISSING"
  [ -f "$MODDIR/overlay/overlay.dex" ] && echo "Float UI: OK ($(wc -c < "$MODDIR/overlay/overlay.dex" 2>/dev/null || echo 0) bytes)" || echo "Float UI: overlay.dex missing"
  [ -f "$CFG" ] && echo "Config: $CFG" || echo "Config: missing"
  [ -f /data/local/tmp/hivirtus_module_heartbeat.txt ] && echo "Heartbeat: $(cat /data/local/tmp/hivirtus_module_heartbeat.txt)"
}

toggle_bool() {
  KEY="$1"
  [ -n "$KEY" ] || return 1
  [ -f "$CFG" ] || return 1
  CUR=$(grep -o "\"$KEY\"[[:space:]]*:[[:space:]]*[a-z]*" "$CFG" | grep -o 'true\|false' | head -n1)
  if [ "$CUR" = "true" ]; then NEW=false; else NEW=true; fi
  sed -i "s/\"$KEY\"[[:space:]]*:[[:space:]]*[a-z]*/\"$KEY\": $NEW/" "$CFG" 2>/dev/null
  cp -f "$CFG" "$RUNTIME" 2>/dev/null
  echo "$KEY -> $NEW"
}

set_string() {
  KEY="$1"
  VAL="$2"
  [ -n "$KEY" ] || return 1
  ESCAPED=$(echo "$VAL" | sed 's/"/\\"/g')
  if grep -q "\"$KEY\"" "$CFG" 2>/dev/null; then
    sed -i "s|\"$KEY\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"$KEY\": \"$ESCAPED\"|" "$CFG"
  else
    echo "Key not in config: $KEY"
    return 1
  fi
  cp -f "$CFG" "$RUNTIME" 2>/dev/null
  echo "$KEY set"
}

case "$1" in
  status) status ;;
  open) echo "Bubble SystemUI se auto start hota hai — reboot / Zygisk ON check karo" ;;
  toggle) toggle_bool "$2" ;;
  set) set_string "$2" "$3" ;;
  *) usage ;;
esac
